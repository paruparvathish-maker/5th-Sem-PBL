# PBL Management Portal Environment Variables

# Turso Database (Serverless SQLite for Vercel Deployment)
# Get these free from https://turso.tech
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Local SQLite Database fallback
DATABASE_URL="file:./dev.db"

# Optional: OpenAI API Key (For Document AI Analysis)
OPENAI_API_KEY="sk-proj-your-key-here"

NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
